# optional machine-specific Python env (not required — the script uses
# the standalone yt-dlp binary it downloads itself)
.venv/

# standalone binaries, auto-downloaded by the script on first use
/yt-dlp
/yt-dlp.exe
/yt-dlp.new
/yt-dlp.exe.new
/ffmpeg
/ffmpeg.exe
/ffmpeg.new

# compiled OCR helper, rebuilt automatically from ocr.swift
/.ocr

# Google OAuth secrets for the YouTube playlist sync — never commit
/google-oauth.json
/.google-token.json

# transient files written while the loggers run (auto-cleaned on exit)
radios/*/chat-*
radios/*/.frame.jpg*
radios/*/.*.lock

# downloaded music (re-fetchable anytime with: radio_tracklog.py download)
radios/*/mp3/

# derived playlist state, rebuilt by: radio_tracklog.py playlist
radios/*/playlist-videos.txt
radios/*/playlist-extra.txt
radios/*/.playlist-quota
# YouTube title cache used by: radio_tracklog.py casing
radios/*/.video-titles.txt

# Python bytecode cache, auto-regenerated
__pycache__/
